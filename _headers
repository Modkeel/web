# Response headers for Cloudflare Workers static assets.
# Home: Link headers point agents at the machine-readable descriptions (RFC 8288, RFC 9727).
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </.well-known/mcp/server-card.json>; rel="service-desc"; type="application/json", </mcp>; rel="service-doc"; type="text/html", </llms.txt>; rel="describedby"; type="text/markdown"

# RFC 9727 requires this media type; the file has no extension to infer it from
/.well-known/api-catalog
  Content-Type: application/linkset+json

/.well-known/agent-skills/*
  Access-Control-Allow-Origin: *

/.well-known/mcp/*
  Access-Control-Allow-Origin: *
